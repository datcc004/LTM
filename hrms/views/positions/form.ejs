<%
  const errors = (typeof validationErrors !== 'undefined' && Array.isArray(validationErrors)) ? validationErrors : [];
  function errorFor(field) {
    const found = errors.find(function (item) { return item.field === field; });
    return found ? found.message : '';
  }
  function value(field) {
    return (values && values[field] !== undefined && values[field] !== null) ? values[field] : '';
  }
%>
<div class="page-heading">
  <div>
    <h1><%= title %></h1>
    <p><%= item ? 'Cập nhật thông tin chức vụ.' : 'Thêm một chức vụ mới vào danh mục.' %></p>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2>Thông tin chức vụ</h2></div>
  <div class="card-body">
    <form action="<%= item ? '/positions/' + item.id : '/positions' %>" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (item) { %><input type="hidden" name="_method" value="put"><% } %>

      <div class="row g-3">
        <div class="col-md-6">
          <div class="form-field">
            <label for="code">Mã chức vụ <span class="text-danger">*</span></label>
            <input type="text" class="form-control <%= errorFor('code') ? 'is-invalid' : '' %>"
                   id="code" name="code" maxlength="30" required value="<%= value('code') %>">
            <% if (errorFor('code')) { %><div class="invalid-feedback"><%= errorFor('code') %></div><% } else { %><span class="form-hint">Ví dụ: TRUONG_PHONG, NHAN_VIEN.</span><% } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-field">
            <label for="name">Tên chức vụ <span class="text-danger">*</span></label>
            <input type="text" class="form-control <%= errorFor('name') ? 'is-invalid' : '' %>"
                   id="name" name="name" maxlength="100" required value="<%= value('name') %>">
            <% if (errorFor('name')) { %><div class="invalid-feedback"><%= errorFor('name') %></div><% } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-field">
            <label for="department_id">Phòng ban áp dụng</label>
            <select class="form-select <%= errorFor('department_id') ? 'is-invalid' : '' %>" id="department_id" name="department_id">
              <option value="">— Dùng chung —</option>
              <% departments.forEach(function (option) { %>
                <option value="<%= option.id %>" <%= String(value('department_id')) === String(option.id) ? 'selected' : '' %>><%= option.name %></option>
              <% }); %>
            </select>
            <% if (errorFor('department_id')) { %><div class="invalid-feedback"><%= errorFor('department_id') %></div><% } %>
            <span class="form-hint">Chức vụ dùng chung sẽ hiển thị cho mọi phòng ban.</span>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-field">
            <label for="is_active">Trạng thái</label>
            <select class="form-select <%= errorFor('is_active') ? 'is-invalid' : '' %>" id="is_active" name="is_active">
              <option value="1" <%= String(value('is_active')) === '1' ? 'selected' : '' %>>Đang hoạt động</option>
              <option value="0" <%= String(value('is_active')) === '0' ? 'selected' : '' %>>Ngừng hoạt động</option>
            </select>
            <% if (errorFor('is_active')) { %><div class="invalid-feedback"><%= errorFor('is_active') %></div><% } %>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">
          <i data-lucide="save" class="icon icon-sm" aria-hidden="true"></i> <%= item ? 'Lưu thay đổi' : 'Thêm chức vụ' %>
        </button>
        <a class="btn btn-outline-secondary" href="/positions">Hủy</a>
      </div>
    </form>
  </div>
</div>
