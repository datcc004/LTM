<%
  const errors = (typeof validationErrors !== 'undefined' && Array.isArray(validationErrors)) ? validationErrors : [];
  function errorFor(field) {
    const found = errors.find(function (item) { return item.field === field; });
    return found ? found.message : '';
  }
  function value(field) {
    return (values && values[field] !== undefined && values[field] !== null) ? values[field] : '';
  }
%>
<div class="page-heading">
  <div>
    <h1><%= title %></h1>
    <p>Ngày lễ lặp hằng năm được áp dụng cho mọi năm dựa trên tháng và ngày.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-outline-secondary" href="/admin/holidays">
      <i data-lucide="arrow-left" class="icon icon-sm" aria-hidden="true"></i> Danh sách ngày lễ
    </a>
  </div>
</div>

<div class="card">
  <div class="card-header"><h2>Thông tin ngày lễ</h2></div>
  <div class="card-body">
    <form action="<%= item ? '/admin/holidays/' + item.id + '/update' : '/admin/holidays' %>" method="post" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="row g-3">
        <div class="col-md-8">
          <div class="form-field">
            <label for="name">Tên ngày lễ <span class="text-danger">*</span></label>
            <input type="text" class="form-control <%= errorFor('name') ? 'is-invalid' : '' %>"
                   id="name" name="name" maxlength="150" required value="<%= value('name') %>" placeholder="Tết Nguyên Đán">
            <% if (errorFor('name')) { %><div class="invalid-feedback"><%= errorFor('name') %></div><% } %>
          </div>
        </div>
        <div class="col-md-4">
          <div class="form-field">
            <label for="holiday_date">Ngày <span class="text-danger">*</span></label>
            <input type="date" class="form-control <%= errorFor('holiday_date') ? 'is-invalid' : '' %>"
                   id="holiday_date" name="holiday_date" required value="<%= value('holiday_date') %>">
            <% if (errorFor('holiday_date')) { %><div class="invalid-feedback"><%= errorFor('holiday_date') %></div><% } %>
          </div>
        </div>
        <div class="col-md-6">
          <div class="form-field">
            <label for="is_recurring">Tính lặp</label>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="is_recurring" name="is_recurring" value="1"
                     <%= String(value('is_recurring')) === '1' || value('is_recurring') === true ? 'checked' : '' %>>
              <label class="form-check-label" for="is_recurring">Lặp hằng năm</label>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="form-field">
            <label for="note">Ghi chú</label>
            <textarea class="form-control <%= errorFor('note') ? 'is-invalid' : '' %>" id="note" name="note" rows="3" maxlength="255" placeholder="Ghi chú thêm (không bắt buộc)"><%= value('note') %></textarea>
            <% if (errorFor('note')) { %><div class="invalid-feedback"><%= errorFor('note') %></div><% } %>
          </div>
        </div>
      </div>

      <div class="d-flex gap-2 mt-3">
        <button type="submit" class="btn btn-primary">
          <i data-lucide="save" class="icon icon-sm" aria-hidden="true"></i> <%= item ? 'Lưu thay đổi' : 'Thêm ngày lễ' %>
        </button>
        <a class="btn btn-outline-secondary" href="/admin/holidays">Hủy</a>
      </div>
    </form>
  </div>
</div>
