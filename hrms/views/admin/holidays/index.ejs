<div class="page-heading">
  <div>
    <h1>Ngày lễ</h1>
    <p>Danh mục ngày nghỉ lễ. Ngày lễ lặp hằng năm được áp dụng cho mọi năm, dùng khi lập lịch ca và tính công.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/admin/holidays/create">
      <i data-lucide="plus" class="icon icon-sm" aria-hidden="true"></i> Thêm ngày lễ
    </a>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <form class="data-table-toolbar" method="get" action="/admin/holidays" role="search">
      <div class="table-filter">
        <label class="visually-hidden" for="filterQ">Tìm kiếm</label>
        <input type="search" class="form-control" id="filterQ" name="q" value="<%= query.q %>" placeholder="Tên hoặc ghi chú ngày lễ">
        <label class="visually-hidden" for="filterYear">Năm</label>
        <input type="number" class="form-control" id="filterYear" name="year" value="<%= query.year %>" min="2000" max="2100" placeholder="Năm">
        <button class="btn btn-primary" type="submit">Lọc</button>
        <a class="btn btn-outline-secondary" href="/admin/holidays">Xóa lọc</a>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table align-middle">
        <caption class="visually-hidden">Danh sách ngày lễ</caption>
        <thead>
          <tr>
            <th scope="col">Tên ngày lễ</th>
            <th scope="col">Ngày</th>
            <th scope="col">Lặp hằng năm</th>
            <th scope="col">Ghi chú</th>
            <th scope="col" class="action-col">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% holidays.forEach(function (row) { %>
            <tr>
              <td><strong><%= row.name %></strong></td>
              <td><%= formatDate(row.holiday_date) %></td>
              <td>
                <span class="badge badge-status <%= Number(row.is_recurring) ? 'info' : 'secondary' %>">
                  <%= Number(row.is_recurring) ? 'Hằng năm' : 'Một lần' %>
                </span>
              </td>
              <td><%= row.note || '—' %></td>
              <td class="action-col">
                <a class="btn btn-sm btn-outline-secondary" href="/admin/holidays/<%= row.id %>/edit" aria-label="Sửa ngày lễ <%= row.name %>">
                  <i data-lucide="pencil" class="icon icon-xs" aria-hidden="true"></i> Sửa
                </a>
                <form method="post" action="/admin/holidays/<%= row.id %>/delete" class="d-inline">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-sm btn-outline-danger"
                          data-confirm="Bạn có chắc muốn xóa ngày lễ <%= row.name %>?"
                          data-confirm-title="Xác nhận xóa ngày lễ"
                          data-confirm-danger>
                    <i data-lucide="trash-2" class="icon icon-xs" aria-hidden="true"></i> Xóa
                  </button>
                </form>
              </td>
            </tr>
          <% }); %>
          <% if (!holidays.length) { %>
            <tr><td colspan="5" class="text-center text-muted py-4">Không có ngày lễ nào phù hợp.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <%- include('../../partials/pagination', { pagination: pagination, basePath: basePath, filterQuery: filterQuery }) %>
  </div>
</div>
