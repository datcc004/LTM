<div class="page-heading">
  <div>
    <h1>Quản lý tài khoản</h1>
    <p>Tạo và quản lý tài khoản đăng nhập, gán vai trò và liên kết nhân viên.</p>
  </div>
  <div class="page-actions">
    <a class="btn btn-primary" href="/admin/users/create">
      <i data-lucide="user-plus" class="icon icon-sm" aria-hidden="true"></i> Thêm tài khoản
    </a>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <form class="data-table-toolbar" method="get" action="/admin/users" role="search">
      <div class="table-filter">
        <label class="visually-hidden" for="filterQ">Tìm kiếm</label>
        <input type="search" class="form-control" id="filterQ" name="q" value="<%= query.q %>" placeholder="Tên đăng nhập, email hoặc họ tên">
        <label class="visually-hidden" for="filterRole">Vai trò</label>
        <select class="form-select" id="filterRole" name="role">
          <option value="">Tất cả vai trò</option>
          <% roles.forEach(function (role) { %>
            <option value="<%= role %>" <%= query.role === role ? 'selected' : '' %>><%= role %></option>
          <% }); %>
        </select>
        <label class="visually-hidden" for="filterActive">Trạng thái</label>
        <select class="form-select" id="filterActive" name="is_active">
          <option value="">Tất cả trạng thái</option>
          <option value="1" <%= query.is_active === '1' ? 'selected' : '' %>>Đang hoạt động</option>
          <option value="0" <%= query.is_active === '0' ? 'selected' : '' %>>Đã khóa</option>
        </select>
        <button class="btn btn-primary" type="submit">Lọc</button>
      </div>
    </form>

    <div class="table-responsive">
      <table class="table align-middle">
        <caption class="visually-hidden">Danh sách tài khoản</caption>
        <thead>
          <tr>
            <th scope="col">Tài khoản</th>
            <th scope="col">Họ tên</th>
            <th scope="col">Vai trò</th>
            <th scope="col">Trạng thái</th>
            <th scope="col">Đăng nhập cuối</th>
            <th scope="col">Thao tác</th>
          </tr>
        </thead>
        <tbody>
          <% users.forEach(function (row) { %>
            <tr>
              <td>
                <strong><%= row.username %></strong>
                <span class="d-block text-muted small"><%= row.email %></span>
              </td>
              <td><%= row.full_name || '—' %><span class="d-block text-muted small"><%= row.employee_code || '' %></span></td>
              <td><span class="badge bg-light text-dark"><%= row.role %></span></td>
              <td>
                <span class="badge badge-status <%= row.is_active ? 'success' : 'danger' %>">
                  <%= row.is_active ? 'Hoạt động' : 'Đã khóa' %>
                </span>
              </td>
              <td><%= row.last_login_at ? formatDateTime(row.last_login_at) : '—' %></td>
              <td>
                <div class="btn-group btn-group-sm">
                  <a class="btn btn-outline-primary" href="/admin/users/<%= row.id %>/edit" title="Sửa">
                    <i data-lucide="pencil" class="icon icon-sm" aria-hidden="true"></i>
                  </a>
                  <form method="post" action="/admin/users/<%= row.id %>/toggle" class="d-inline">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button class="btn btn-outline-<%= row.is_active ? 'warning' : 'success' %>" type="submit"
                      title="<%= row.is_active ? 'Khóa' : 'Mở khóa' %>"
                      <%= Number(row.id) === Number(user.id) ? 'disabled' : '' %>>
                      <i data-lucide="<%= row.is_active ? 'lock' : 'unlock' %>" class="icon icon-sm" aria-hidden="true"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
          <% if (!users.length) { %>
            <tr><td colspan="6" class="text-center text-muted py-4">Không có tài khoản nào phù hợp.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <%- include('../../partials/pagination', { pagination: pagination, basePath: basePath, filterQuery: filterQuery }) %>
  </div>
</div>
