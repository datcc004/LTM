<div class="page-heading">
  <div>
    <h1>Thông tin cá nhân</h1>
    <p>Hồ sơ nhân viên liên kết với tài khoản đăng nhập của bạn.</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body text-center">
        <span class="avatar avatar-lg mx-auto mb-3" aria-hidden="true">
          <% if (user && user.avatar_path) { %>
            <img src="/uploads/<%= user.avatar_path %>" alt="">
          <% } else { %>
            <%= (user && (user.full_name || user.username) || '?').split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase() %>
          <% } %>
        </span>
        <h2 class="h5 mb-1"><%= user ? (user.full_name || user.username) : '—' %></h2>
        <p class="text-muted small mb-2"><%= profile ? profile.employee_code : (user ? user.username : '') %></p>
        <% if (profile) { %>
          <span class="badge badge-status <%= profile.status === 'Đang làm việc' ? 'success' : 'warning' %>"><%= profile.status %></span>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><h2>Thông tin chi tiết</h2></div>
      <div class="card-body">
        <% if (profile) { %>
          <div class="row g-3">
            <div class="col-md-6"><span class="form-hint">Họ và tên</span><div><%= profile.full_name %></div></div>
            <div class="col-md-6"><span class="form-hint">Giới tính</span><div><%= profile.gender %></div></div>
            <div class="col-md-6"><span class="form-hint">Ngày sinh</span><div><%= profile.date_of_birth %></div></div>
            <div class="col-md-6"><span class="form-hint">Ngày vào làm</span><div><%= profile.hire_date %></div></div>
            <div class="col-md-6"><span class="form-hint">Phòng ban</span><div><%= profile.department_name || '—' %></div></div>
            <div class="col-md-6"><span class="form-hint">Chức vụ</span><div><%= profile.position_name || '—' %></div></div>
            <div class="col-md-6"><span class="form-hint">Quản lý trực tiếp</span><div><%= profile.manager_name || '—' %></div></div>
            <div class="col-md-6"><span class="form-hint">Điện thoại</span><div><%= profile.phone || '—' %></div></div>
            <div class="col-md-6"><span class="form-hint">Email</span><div><%= profile.email || '—' %></div></div>
            <div class="col-md-6"><span class="form-hint">Địa chỉ</span><div><%= profile.address || '—' %></div></div>
          </div>
        <% } else { %>
          <p class="text-muted mb-0">Tài khoản này chưa được liên kết với hồ sơ nhân viên.</p>
          <dl class="row mb-0 mt-2">
            <dt class="col-sm-3">Tên đăng nhập</dt><dd class="col-sm-9"><%= user ? user.username : '—' %></dd>
            <dt class="col-sm-3">Vai trò</dt><dd class="col-sm-9"><%= user ? user.role : '—' %></dd>
          </dl>
        <% } %>
      </div>
    </div>
  </div>
</div>
