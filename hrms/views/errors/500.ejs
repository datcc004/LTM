<div class="error-page">
  <div class="error-card">
    <div class="error-illustration is-error" aria-hidden="true"><i data-lucide="octagon-alert" class="icon"></i></div>
    <p class="error-code">500</p>
    <h1>Đã xảy ra lỗi hệ thống</h1>
    <p class="error-message"><%= message || 'Đang có lỗi xảy ra. Vui lòng thử lại sau.' %></p>
    <% if (typeof code !== 'undefined' && code) { %><p class="error-detail">Mã lỗi: <code><%= code %></code></p><% } %>
    <div class="error-actions">
      <a href="javascript:location.reload()" class="btn btn-primary"><i data-lucide="rotate-cw" class="icon icon-sm" aria-hidden="true"></i> Thử lại</a>
      <a href="/dashboard" class="btn btn-outline-secondary"><i data-lucide="layout-dashboard" class="icon icon-sm" aria-hidden="true"></i> Về trang chủ</a>
    </div>
  </div>
</div>
