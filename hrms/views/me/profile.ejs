<div class="page-heading">
  <div>
    <h1>Hồ sơ của tôi</h1>
    <p>Thông tin nhân viên liên kết với tài khoản đăng nhập. Chỉ bạn mới xem được trang này.</p>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-4">
    <div class="card">
      <div class="card-body text-center">
        <span class="avatar avatar-lg mx-auto mb-3" aria-hidden="true">
          <% if (employee.avatar_path) { %>
            <img src="/uploads/<%= employee.avatar_path %>" alt="">
          <% } else { %>
            <%= (employee.full_name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join('').toUpperCase() %>
          <% } %>
        </span>
        <h2 class="h5 mb-1"><%= employee.full_name %></h2>
        <p class="text-muted small mb-2"><%= employee.employee_code %></p>
        <span class="badge badge-status <%= employee.status === 'Đang làm việc' ? 'success' : 'warning' %>"><%= employee.status %></span>
      </div>
    </div>
  </div>

  <div class="col-lg-8">
    <div class="card">
      <div class="card-header"><h2>Thông tin cá nhân</h2></div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-6">
            <span class="d-block text-muted small">Phòng ban</span>
            <strong><%= employee.department_name || '—' %></strong>
          </div>
          <div class="col-md-6">
            <span class="d-block text-muted small">Chức vụ</span>
            <strong><%= employee.position_name || '—' %></strong>
          </div>
          <div class="col-md-6">
            <span class="d-block text-muted small">Quản lý trực tiếp</span>
            <strong><%= employee.manager_name || '—' %></strong>
          </div>
          <div class="col-md-6">
            <span class="d-block text-muted small">Ngày vào làm</span>
            <strong><%= formatDate(employee.hire_date) %></strong>
          </div>
          <div class="col-md-6">
            <span class="d-block text-muted small">Điện thoại</span>
            <strong><%= employee.phone || '—' %></strong>
          </div>
          <div class="col-md-6">
            <span class="d-block text-muted small">Email</span>
            <strong><%= employee.email || '—' %></strong>
          </div>
          <div class="col-12">
            <span class="d-block text-muted small">Địa chỉ</span>
            <strong><%= employee.address || '—' %></strong>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="card mt-3">
  <div class="card-header"><h2>Quỹ phép năm <%= year %></h2></div>
  <div class="card-body">
    <div class="table-responsive">
      <table class="table align-middle">
        <caption class="visually-hidden">Quỹ phép của bạn</caption>
        <thead>
          <tr>
            <th scope="col">Loại phép</th>
            <th scope="col" class="numeric">Đầu năm</th>
            <th scope="col" class="numeric">Cộng thêm</th>
            <th scope="col" class="numeric">Đã dùng</th>
            <th scope="col" class="numeric">Còn lại</th>
          </tr>
        </thead>
        <tbody>
          <% leaveBalances.forEach(function (row) { %>
            <tr>
              <td><%= row.leave_type_name %></td>
              <td class="numeric"><%= formatNumber(row.opening_days, 2) %></td>
              <td class="numeric"><%= formatNumber(row.accrued_days, 2) %></td>
              <td class="numeric"><%= formatNumber(row.used_days, 2) %></td>
              <td class="numeric"><strong><%= formatNumber(row.remaining_days, 2) %></strong></td>
            </tr>
          <% }); %>
          <% if (!leaveBalances.length) { %>
            <tr><td colspan="5" class="text-center text-muted py-4">Chưa có quỹ phép cho năm này.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
