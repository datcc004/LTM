# ============================================================
# KIDS PARK HRMS - Cấu hình môi trường
# Copy sang .env rồi điền giá trị thực. Không commit file .env.
# ============================================================

NODE_ENV=development
PORT=3000
APP_NAME=KIDS PARK HRMS
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# MySQL 8.0
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kids_park_hrms
DB_POOL_LIMIT=10

# ------------------------------------------------------------
# Phiên đăng nhập & bảo mật
# Tạo chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
SESSION_SECRET=thay_bang_chuoi_ngau_nhien_48_byte_o_day
SESSION_NAME=kp_hrms.sid
SESSION_MAX_AGE=86400000
CSRF_SECRET=thay_bang_chuoi_ngau_nhien_khac_o_day
BCRYPT_ROUNDS=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=30

# ------------------------------------------------------------
# Upload & export PDF
# PDFKit cần font TTF để render tiếng Việt. Để trống để tự dò
# C:/Windows/Fonts/arial.ttf (Windows) hoặc DejaVu/Liberation/Noto (Linux).
# ------------------------------------------------------------
UPLOAD_DIR=public/uploads
MAX_AVATAR_SIZE=2097152
MAX_DOC_SIZE=10485760
PDF_FONT_PATH=

# ------------------------------------------------------------
# Múi giờ & nghiệp vụ
# ------------------------------------------------------------
TZ=Asia/Ho_Chi_Minh
CONTRACT_ALERT_DAYS=30
STANDARD_WORK_HOURS=8
